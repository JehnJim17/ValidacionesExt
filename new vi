<div id="front-home" class="home-wrapper">
    <div class="home-inner">
        <div class="home-left">
            <h1 class="home-title">VERONA</h1>
            <p style="color:white">Centro de Sinergias de Abastecimiento</p>
        </div>
        <div class="home-right">
            <div class="home-card">
                <button class="btn-main" onclick="iniciarConsulta('contratos')">CONSULTAR CONTRATOS</button>
                <button class="btn-main secondary" onclick="iniciarConsulta('solicitudes')">CONSULTAR SOLICITUDES</button>
            </div>
        </div>
    </div>
</div>

<div id="front-filtros" class="u-hidden">
    <div class="banner">
        <div class="banner-back-circle" onclick="regresarAlHome()">←</div>
        <div class="banner-title" id="titulo-pagina">Mis Consultas</div>
    </div>
    <div class="main-content">
        <div id="loading-spinner" class="u-hidden">Cargando datos...</div>
        <table id="tabla-resultados">
            <thead id="cabecera-tabla"></thead>
            <tbody id="cuerpo-tabla"></tbody>
        </table>
    </div>
</div>

<script>
    const state = {
        currentMode: '', // 'contratos' o 'solicitudes'
        webhookUrl: "https://prod-07.brazilsouth.logic.azure.com:443/...", // Tu URL de Power Automate
        origen: document.referrer ? new URL(document.referrer).origin : window.location.origin
    };

    function iniciarConsulta(modo) {
        state.currentMode = modo;
        
        // Cambio visual de pantallas
        document.getElementById('front-home').classList.add('u-hidden');
        document.getElementById('front-filtros').classList.remove('u-hidden');
        document.getElementById('titulo-pagina').innerText = modo === 'contratos' ? 'Mis Contratos' : 'Mis Solicitudes';
        
        // Llamada directa al flujo sin pasar por correos o esperas
        cargarDatosDesdePowerAutomate();
    }

    async function cargarDatosDesdePowerAutomate() {
        const loader = document.getElementById('loading-spinner');
        loader.classList.remove('u-hidden');

        const payload = {
            origen: state.origen,
            tipoConsulta: state.currentMode,
            accion: "fetch_data"
        };

        try {
            const response = await fetch(state.webhookUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            renderizarTabla(data.datos || []);
        } catch (error) {
            console.error("Error en la consulta:", error);
            alert("No se pudieron obtener los datos de Power Automate.");
        } finally {
            loader.classList.add('u-hidden');
        }
    }

    function regresarAlHome() {
        document.getElementById('front-filtros').classList.add('u-hidden');
        document.getElementById('front-home').classList.remove('u-hidden');
    }

    function renderizarTabla(datos) {
        const cuerpo = document.getElementById('cuerpo-tabla');
        cuerpo.innerHTML = datos.map(item => `
            <tr>
                <td>${item.id || item.key}</td>
                <td>${item.nombre || item.summary}</td>
                <td>${item.estado || item.status}</td>
            </tr>
        `).join('');
    }
</script>
